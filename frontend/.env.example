# Firebase Web App config (Firebase console -> Project settings -> Your apps -> Web app)
# Copy this file to .env and fill in the values, then restart `npm run dev`.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Astral AI Copilot: model ID sent to the backend proxy (the API key lives in backend/.env, never here)
VITE_CLAUDE_MODEL=claude-sonnet-5-5

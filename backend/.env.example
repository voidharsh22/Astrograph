# Astral Cartographer - Environment Configuration Example
# Copy to .env or configure in your environment.

# Storage location for SQLite database and extracted repository workspaces
ASTRAL_DATA_DIR=./data

# Ingestion and Archive Limits
ASTRAL_MAX_ARCHIVE_MB=100
ASTRAL_MAX_EXTRACTED_MB=500
ASTRAL_MAX_FILES=20000
ASTRAL_MAX_SINGLE_FILE_MB=20

# Source File Access Limits
ASTRAL_MAX_SOURCE_RESPONSE_MB=1

# Concurrent Background Indexing Jobs (in-process thread pool)
ASTRAL_MAX_CONCURRENT_JOBS=2

# CORS Allowed Origins (comma-separated URLs)
ASTRAL_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Server Binding
ASTRAL_HOST=127.0.0.1
ASTRAL_PORT=8000

# AI assistant (server-side only; never exposed to the browser).
# The provider is auto-detected: the first of GEMINI_API_KEY / ANTHROPIC_API_KEY that is set.
# Force one with AI_PROVIDER=gemini|anthropic. There is no simulated fallback: without a key the
# assistant reports "AI unavailable" with these instructions.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_PROVIDER=
AI_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_CONTEXT_CHARS=24000

# --- GitHub App: private repository access (optional; public imports never need it) ---
# See "Private repositories (GitHub App)" in README.md for the manual app registration steps.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Provide the PEM either inline (use 
 for newlines) or as a file path - never commit the key.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
# Origin GitHub redirects to (callback = <this>/api/github/callback) and the web UI origin.
ASTRAL_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
ASTRAL_FRONTEND_URL=http://localhost:5173
# Lifetime of an Astrograph GitHub session in minutes (GitHub user tokens last 8h).
ASTRAL_GITHUB_SESSION_TTL_MINUTES=480
# Private source is never sent to Gemini/Anthropic unless you opt in here.
ASTRAL_ALLOW_AI_ON_PRIVATE_REPOS=false

# --- Account authentication (email/password + Google sign-in) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (type: Web application).
# Leave empty to disable Google sign-in (email/password still works). The secret stays server-side only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Defaults to <ASTRAL_FRONTEND_URL>/api/auth/google/callback and must EXACTLY match an
# "Authorized redirect URI" in Google Cloud Console.
GOOGLE_REDIRECT_URI=
# Server-side login session lifetime in days (HttpOnly cookie; Secure is set automatically for https ASTRAL_FRONTEND_URL).
ASTRAL_SESSION_DAYS=7
